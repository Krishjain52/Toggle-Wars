# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Flagsmith: client-side environment key (Environment settings → SDK keys)
FLAGSMITH_ENVIRONMENT_KEY=

# Self-hosted only (leave empty for Flagsmith Cloud)
# FLAGSMITH_SDK_API_URL=http://localhost:8000/api/v1/
# FLAGSMITH_EVENTS_URL=http://localhost:8000/api/
# FLAGSMITH_DASHBOARD_URL=http://localhost:8000

# Arena tuning (optional)
# GENERATIONS=3
# CHALLENGERS=3
# VISITORS_PER_GENERATION=240
# WIN_THRESHOLD=0.9
# DESIGNER_MODEL=gemini-3.8-flash
# VISITOR_MODEL=gemini-3.5-flash-lite
